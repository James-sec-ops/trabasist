# Copy this file to .env and fill in real values. Never commit .env.
# For each device, add two lines named after its credentials label.
# Example: a device with label KALI_LAB reads KALI_LAB_USERNAME and KALI_LAB_PASSWORD.
# Use a read-only account on lab devices, not an admin account.
#
# python -m trabasist_server.add_device writes these lines for you.

KALI_LAB_USERNAME=readonly_user
KALI_LAB_PASSWORD=change_me
